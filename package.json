{
  "name": "@up-nuxt/states",
  "version": "1.0.0",
  "description": "Define shared Nuxt state using the same Composition API you already use in composables.",
  "keywords": [
    "composable",
    "nuxt",
    "nuxt-module",
    "state",
    "vue"
  ],
  "homepage": "https://github.com/up-nuxt/states#readme",
  "bugs": {
    "url": "https://github.com/up-nuxt/states/issues"
  },
  "license": "MIT",
  "author": "Navid Talebian",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/up-nuxt/states.git"
  },
  "workspaces": [
    "playground"
  ],
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "bench:bundle-size": "pnpm run prepack && node benchmarks/bundle-size/run.mjs",
    "prepack": "nuxt-module-build build",
    "dev": "pnpm dev:prepare && nuxt dev playground",
    "dev:build": "nuxt build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxt prepare playground",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "vitest run",
    "test:browser": "vitest run test/browser",
    "test:stress": "vitest run --config vitest.stress.config.ts",
    "check": "pnpm run fmt:check && pnpm run lint",
    "test:watch": "vitest",
    "test:types": "nuxt-module-build prepare && nuxt-module-build build && vue-tsc --noEmit && nuxt prepare playground && pnpm --dir playground exec vue-tsc --noEmit"
  },
  "dependencies": {
    "@nuxt/devtools-kit": "^4.2.0",
    "@nuxt/kit": "^4.6.4"
  },
  "devDependencies": {
    "@nuxt/devtools": "^4.2.0",
    "@nuxt/eslint-config": "^1.17.0",
    "@nuxt/module-builder": "^1.0.4",
    "@nuxt/schema": "^4.6.4",
    "@nuxt/test-utils": "^4.4.0",
    "@pinia/nuxt": "1.0.3",
    "@types/node": "^24.19.2",
    "changelogen": "^0.6.2",
    "happy-dom": "^21.0.4",
    "nuxt": "^4.6.4",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "pinia": "4.1.0",
    "playwright-core": "^1.65.1",
    "typescript": "6.0.3",
    "vitest": "^5.1.0",
    "vue": "^3.5.45",
    "vue-tsc": "^3.3.14"
  },
  "engines": {
    "node": "^24.0.0 || ^26.0.0"
  },
  "packageManager": "pnpm@11.17.0"
}
